DISCORD_BOT_TOKEN=your-discord-bot-token
DB_PATH=data/jobs.db
CHECK_INTERVAL_MINUTES=5
LOG_LEVEL=INFO

# Proxy opcional para portales (Worker diseñado para Cloudflare).
# En local, deja URL/token vacíos y usa JOB_PROXY_MODE=off para conectar directo.
JOB_PROXY_URL=
JOB_PROXY_TOKEN=
JOB_PROXY_MODE=off

# Tope diario de peticiones al Worker (plan gratis de Cloudflare: 100000/día UTC).
# Al llegar al tope el bot va directo hasta las 00:00 UTC. 0 = sin tope.
JOB_PROXY_DAILY_LIMIT=90000
