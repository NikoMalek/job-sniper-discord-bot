        </article>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-exp-compare]');
      if (!root) return;
      const buttons = Array.from(root.querySelectorAll('.mode-btn'));
      const panels = Array.from(root.querySelectorAll('.mode-panel'));
      function setMode(mode) {
        buttons.forEach((btn) => {
          const active = btn.getAttribute('data-mode') === mode;
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          const active = panel.getAttribute('data-panel') === mode;
          if (active) panel.removeAttribute('hidden');
          else panel.setAttribute('hidden', '');
        });
      }
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => setMode(btn.getAttribute('data-mode') || 'normal'));
      });
      setMode('normal');

      // Interactive mock select for "¿Postulaste?" (like Discord modal select)
      const selects = Array.from(root.querySelectorAll('[data-mock-select]'));
      selects.forEach((select) => {
        const trigger = select.querySelector('.d-select-trigger');
        const optionsWrap = select.querySelector('.d-select-options');
        const valueEl = select.querySelector('[data-select-value]');
        const options = Array.from(select.querySelectorAll('.d-select-option'));
        if (!trigger || !optionsWrap || !valueEl) return;
        function close() {
          optionsWrap.setAttribute('hidden', '');
          trigger.setAttribute('aria-expanded', 'false');
        }
        function open() {
          optionsWrap.removeAttribute('hidden');
          trigger.setAttribute('aria-expanded', 'true');
        }
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          if (optionsWrap.hasAttribute('hidden')) open();
          else close();
        });
        options.forEach((opt) => {
          opt.addEventListener('click', (e) => {
            e.stopPropagation();
            valueEl.textContent = opt.textContent || '';
            trigger.classList.add('has-value');
            close();
          });
        });
        select.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !optionsWrap.hasAttribute('hidden')) {
            e.preventDefault();
            close();
            trigger.focus();
          }
        });
      });
      document.addEventListener('click', (e) => {
        selects.forEach((select) => {
          if (!select.contains(e.target)) {
            const optionsWrap = select.querySelector('.d-select-options');
            const trigger = select.querySelector('.d-select-trigger');
            if (optionsWrap && trigger) {
              optionsWrap.setAttribute('hidden', '');
              trigger.setAttribute('aria-expanded', 'false');
            }
          }
        });
      });

      // Functional /applications pagination mock (5 per page)
      const appsMock = document.querySelector('[data-apps-mock]');
      if (appsMock) {
        const pages = Array.from(appsMock.querySelectorAll('.apps-page'));
        const prev = appsMock.querySelector('[data-apps-prev]');
        const next = appsMock.querySelector('[data-apps-next]');
        const footer = appsMock.querySelector('[data-apps-footer]');
        let pageIndex = 0;
        const totalRecords = 12;
        function render() {
          pages.forEach((p, i) => {
            if (i === pageIndex) p.removeAttribute('hidden');
            else p.setAttribute('hidden', '');
          });
          if (prev) prev.disabled = pageIndex === 0;
          if (next) next.disabled = pageIndex >= pages.length - 1;
          if (footer) footer.textContent = `Página ${pageIndex + 1}/${pages.length} · ${totalRecords} registros`;
        }
        if (prev) prev.addEventListener('click', () => { if (pageIndex > 0) { pageIndex -= 1; render(); } });
        if (next) next.addEventListener('click', () => { if (pageIndex < pages.length - 1) { pageIndex += 1; render(); } });
        render();
      }
    })();
  </script>
</BaseLayout>